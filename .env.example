# =============================================================================
# Vendor Reliability Intelligence Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vendor_reliability_db

# --- JWT Authentication ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=your-super-secret-jwt-key-replace-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# --- Application ---
APP_NAME=Vendor Reliability Intelligence Platform
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- Security ---
# Minimum password length
MIN_PASSWORD_LENGTH=8
# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=480

