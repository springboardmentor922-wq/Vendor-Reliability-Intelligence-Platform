# ── Docker / Production .env.example ─────────────────────────────────────────
# Copy this file to .env and fill in your own values before running:
#   cp .env.example .env
#
# NEVER commit a filled-in .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=procurement_db
POSTGRES_PORT=5432          # host port exposed by the postgres container

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379             # host port exposed by the redis container

# ── Backend ───────────────────────────────────────────────────────────────────
# JWT secret — use a long, random string in production
SECRET_KEY=procurement-super-secret-jwt-key-2026-change-me-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of origins allowed by CORS (add your production domain)
CORS_ORIGINS=http://localhost,http://localhost:80

# Host port on which the backend is exposed (default 8000)
BACKEND_PORT=8000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Host port on which the frontend (nginx) is exposed (default 80)
FRONTEND_PORT=80
