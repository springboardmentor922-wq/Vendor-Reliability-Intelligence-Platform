# App
PROJECT_NAME=VendorIQ
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60*24

# Database
# For local dev without Postgres, sqlite is used automatically as a fallback.
DATABASE_URL=postgresql://vendoriq:vendoriq@db:5432/vendoriq

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:4200"]

# First admin user (seeded on startup)
FIRST_ADMIN_EMAIL=admin@vendoriq.com
FIRST_ADMIN_PASSWORD=Admin@123
