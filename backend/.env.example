# Copy this file to .env and update the values for your local environment.
# Never commit your .env file — it is already in .gitignore.

# Database (MySQL)
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/vendor_db

# JWT secret (generate a new random secret with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=YOUR_RANDOM_SECRET_HERE
