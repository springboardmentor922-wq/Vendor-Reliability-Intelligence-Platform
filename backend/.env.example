# Environment variables for VendorIQ Backend

PROJECT_NAME=VendorIQ – Vendor Reliability Platform
API_V1_STR=/api
SECRET_KEY=super-secret-jwt-key-for-vendoriq-risk-management-platform
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Connection String (or sqlite:///./vendoriq.db for standalone SQLite dev)
DATABASE_URL=postgresql://vendoriq:vendoriq_password@localhost:5432/vendoriq_db

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
